<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the project core (Project/*.cs) outside the game: format 2, migration, history, problem list, import,
       install and publish. Run it with "dotnet run" in this folder; it prints one line per check and exits 1 on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <DeployVerifyDisable>true</DeployVerifyDisable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Project/*.cs" Link="Project/%(Filename).cs" />
    <Compile Include="../../Editor/NpcModel.cs" Link="Editor/NpcModel.cs" />
    <Compile Include="../../Editor/Ids.cs" Link="Editor/Ids.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
